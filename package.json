{
  "name": "hakk-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"API_PORT=3001 node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js --reset",
    "content": "node --disable-warning=ExperimentalWarning server/content.js",
    "passwords": "node --disable-warning=ExperimentalWarning server/passwords.js",
    "public": "npm run build && NODE_ENV=production PORT=8080 node --disable-warning=ExperimentalWarning server/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  }
}
